{
  "name": "dsh-plugin-autoupdater",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Checks installed plugins for newer npm releases and updates them automatically, falling back to uninstall + reinstall when the in-place update is refused.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "license": "MIT",
  "author": "wy7779",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wy7779/dsh-plugin-autoupdater.git"
  },
  "homepage": "https://github.com/wy7779/dsh-plugin-autoupdater#readme",
  "bugs": {
    "url": "https://github.com/wy7779/dsh-plugin-autoupdater/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "auto-update"
  ]
}
